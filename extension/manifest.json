{
  "manifest_version": 3,
  "name": "SLAB — Self-Learning Agent Browser",
  "version": "1.0.0",
  "description": "Voice- and gaze-controlled autonomous browser agent with offline extractive summarization, per-site habit memory, and 98% token reduction.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SLAB AI Voice & Gaze Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/webgazer.js", "content/gaze-main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "css": ["content/content-styles.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "onboarding/onboarding.html",
        "onboarding/onboarding.css",
        "onboarding/onboarding.js",
        "options/options.html",
        "options/options.css",
        "options/options.js",
        "permission.html",
        "permission.js",
        "lib/webgazer.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open SLAB Agent Popup"
    },
    "open_command_palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open SLAB In-Page Command Palette"
    }
  }
}
