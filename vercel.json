{
  "version": 2,
  "builds": [
    {
      "src": "dist/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/dist/src/server.js" },
    { "src": "/health",   "dest": "/dist/src/server.js" },
    { "src": "/(.*)",     "dest": "/public/$1" }
  ]
}
